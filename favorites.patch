diff --git a/src/db/schema.ts b/src/db/schema.ts
index 3b6ca8a..a337e7b 100644
--- a/src/db/schema.ts
+++ b/src/db/schema.ts
@@ -109,6 +109,34 @@ export const comments = pgTable(
   (t) => [index("comments_photo_idx").on(t.photoId, t.createdAt)],
