+/* ── Photo grid sizing ───────────────────────────────────────────────────────
+ *
+ * The −/+ control puts one of `size-1` … `size-5` on the grid container and
+ * nothing else. Every decision about how big a thumbnail is lives in this
+ * block. React sets the class; the numbers are yours.
+ *
+ * Two grids, two modifiers, because they're very different widths:
+ *
+ *   .photo-grid--page    the gallery on /browse, capped at max-w-5xl but as
+ *                        narrow as a phone. Sized by target tile width, so the
+ *                        column count falls out of whatever space there is.
+ *
+ *   .photo-grid--panel   the map panel: a bottom sheet on a phone, a side panel
+ *                        from 300px to 880px on a desktop. Sized by explicit
+ *                        column count, so every press of + changes something
+ *                        even when the panel is narrow.
+ *
+ * They each remember their own step, so changing one doesn't disturb the other.
+ * To add a sixth step, add the rules and bump STEP_COUNT in
+ * src/lib/client/tile-size.ts.
+ */
+
+.photo-grid {
+  display: grid;
+  gap: 4px;
+}
+
+/* Not optional for the map panel. Its grid is a flex child of a max-height
+   section, so it has a definite height, and the default `align-content:
+   stretch` would divide that height evenly across the rows — flattening the
+   square tiles into bands however tall the panel happens to be. */
+.photo-grid--panel {
+  align-content: start;
+}
+
+.photo-tile {
+  aspect-ratio: 1 / 1;
+}
+
+/* `min(…, 100%)` so a container narrower than one tile lays out a single
+   column instead of spilling sideways. */
+.photo-grid--page.size-1 {
+  grid-template-columns: repeat(auto-fill, minmax(min(88px, 100%), 1fr));
+}
+.photo-grid--page.size-2 {
+  grid-template-columns: repeat(auto-fill, minmax(min(116px, 100%), 1fr));
+}
+.photo-grid--page.size-3 {
+  grid-template-columns: repeat(auto-fill, minmax(min(152px, 100%), 1fr));
+}
+.photo-grid--page.size-4 {
+  grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
+}
+.photo-grid--page.size-5 {
+  grid-template-columns: repeat(auto-fill, minmax(min(256px, 100%), 1fr));
+}
+
+.photo-grid--panel.size-1 {
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+}
+.photo-grid--panel.size-2 {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+.photo-grid--panel.size-3 {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.photo-grid--panel.size-4 {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+.photo-grid--panel.size-5 {
+  grid-template-columns: repeat(1, minmax(0, 1fr));
+}
+
 .scroll-slim::-webkit-scrollbar {
   width: 8px;
   height: 8px;
